NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-random-value-before-deployment

# MySQL settings used by the registration migration and account storage.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medigo
DB_USER=root
DB_PASSWORD=
TERMS_VERSION=v1
PRIVACY_VERSION=v1
APP_BASE_URL=http://localhost:3000

# Configure these SMTP values to deliver verification links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Meta WhatsApp Cloud API. Never commit real tokens or app secrets.
META_WHATSAPP_ACCESS_TOKEN=your_meta_access_token
META_WHATSAPP_APP_SECRET=your_meta_app_secret
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_private_verify_token
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_TEMPLATE_LANGUAGE=es_CO
META_WHATSAPP_VERIFICATION_TEMPLATE_NAME=
META_WHATSAPP_CONFIRMATION_TEMPLATE_NAME=
META_WHATSAPP_REMINDER_TEMPLATE_NAME=
META_WHATSAPP_RESCHEDULE_TEMPLATE_NAME=
META_WHATSAPP_CANCELLATION_TEMPLATE_NAME=
WHATSAPP_VERIFICATION_SECRET=replace-with-a-long-random-secret

# Legacy WHATSAPP_* provider variables remain supported as a fallback.
