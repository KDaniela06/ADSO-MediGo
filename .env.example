NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-random-value-before-deployment

# MySQL settings used by the registration migration and account storage.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medigo
DB_USER=root
DB_PASSWORD=
TERMS_VERSION=v1
PRIVACY_VERSION=v1
APP_BASE_URL=http://localhost:3000

# Configure these SMTP values to deliver verification links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# Meta WhatsApp Cloud API. Use a Meta-approved authentication template with one body variable.
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFICATION_TEMPLATE=
WHATSAPP_VERIFICATION_TEMPLATE_LANGUAGE=es
WHATSAPP_VERIFICATION_SECRET=replace-with-a-long-random-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token
WHATSAPP_APP_SECRET=your-meta-app-secret
