header.app-topbar
  button.app-navigation-toggle(type="button", data-app-navigation-toggle, aria-controls="app-navigation", aria-expanded="false", aria-label="Abrir menú de navegación")
    svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", aria-hidden="true")
      path(d="M4 6h16M4 12h16M4 18h16")
  a.app-topbar-brand(href=currentUser.role === "PATIENT" ? "/paciente" : currentUser.role === "DOCTOR" ? "/medico" : "/administrador", aria-label="MediGo, inicio") Medi#[span(class="text-medigo-cyan") Go]

button.app-navigation-backdrop.hidden(type="button", data-app-navigation-backdrop, aria-label="Cerrar menú de navegación")
aside#app-navigation.app-navigation(data-app-navigation, role="dialog", aria-modal="true", aria-labelledby="app-navigation-title", aria-hidden="true", inert)
  .app-navigation-heading
    div
      p.app-navigation-eyebrow Navegación
      h2#app-navigation-title.app-navigation-title Menú principal
    button.app-navigation-close(type="button", data-app-navigation-close, aria-label="Cerrar menú de navegación")
      svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", aria-hidden="true")
        path(d="m6 6 12 12M18 6 6 18")
  p.app-navigation-greeting Hola, #{currentUser.firstName}
  nav.app-navigation-links(aria-label="Secciones de MediGo")
    each item in appNavigationItems[currentUser.role] || []
      a.app-navigation-link(class=item.id === activeAppNavigationItem ? "is-active" : "", href=item.href, aria-current=item.id === activeAppNavigationItem ? "page" : undefined)
        span.app-navigation-link-mark(aria-hidden="true")
        span= item.label
  .app-navigation-footer
    p.app-navigation-footer-note Tu salud, en buenas manos
    form(action="/cerrar-sesion", method="post")
      input(type="hidden", name="_csrf", value=csrfToken)
      button.app-navigation-logout(type="submit") Cerrar sesión
