extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto flex min-h-screen max-w-5xl items-center px-4 py-6 sm:px-6")
    section(class="w-full overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-sky-100")
      h1(class="rounded-t-2xl bg-medigo-navy px-5 py-3 text-xl font-bold text-white sm:px-8 sm:text-2xl") Registro de Paciente
      div(class="grid md:min-h-[760px] md:grid-cols-[0.9fr_1.1fr]")
        aside(class="relative flex flex-col items-center justify-center overflow-hidden bg-gradient-to-b from-sky-50 via-sky-100 to-cyan-100 px-8 py-10 text-center")
          div(class="absolute -bottom-16 -left-10 h-44 w-[130%] -rotate-3 rounded-[50%] bg-medigo-cyan/80")
          div(class="absolute -bottom-24 -left-8 h-40 w-[130%] rotate-3 rounded-[50%] bg-medigo-blue/90")
          div(class="relative z-10 mb-12 flex h-44 w-full max-w-xs items-center justify-center rounded-3xl bg-white/70 text-medigo-blue")
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 240 150", fill="none", class="h-36 w-56", role="img", aria-label="MediGo")
              path(d="M32 92c4-22 24-36 44-31 8-26 44-35 63-14 20-9 44 3 47 24 20 0 31 15 28 33H41c-7 0-11-5-9-12Z", stroke="#0876c9", stroke-width="8", stroke-linecap="round", stroke-linejoin="round")
              path(d="M95 57c-12-9-25 1-21 16 4 15 20 29 20 29s16-14 20-29c4-15-9-25-21-16Z", fill="#12b8e8")
              path(d="M94 67v23m-11-12h22", stroke="white", stroke-width="6", stroke-linecap="round")
              path(d="M139 71h30l8 8v24h-38V71Zm8-8v8m15-8v8m-16 18h4m8 0h4m-16 8h4m8 0h4", stroke="#0b3b69", stroke-width="4", stroke-linecap="round", stroke-linejoin="round")
              circle(cx="177", cy="105", r="11", fill="#12b8e8")
              path(d="m172 105 4 4 7-8", stroke="white", stroke-width="3", stroke-linecap="round", stroke-linejoin="round")
              text(x="120", y="132", text-anchor="middle", fill="#0b3b69", font-size="25", font-weight="700", font-family="Arial, sans-serif") MediGo
              text(x="120", y="146", text-anchor="middle", fill="#0b3b69", font-size="8", font-family="Arial, sans-serif") Tu salud, en buenas manos
          div(class="relative z-10 max-w-sm")
            h2(class="text-xl font-bold text-medigo-navy") Bienvenido a MediGo
            p(class="mt-2 text-sm leading-6 text-slate-700") Regístrate para agendar tus citas y cuidar tu salud.
        section(class="px-5 py-8 sm:px-9 sm:py-10")
          h2(class="text-2xl font-bold text-medigo-navy") Crear cuenta de paciente
          p(class="mt-1 text-sm text-slate-600") Completa tus datos para comenzar
          if formError
            p(class="mt-4 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-800", role="alert")= formError
          if successMessage
            p(class="mt-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-900", role="status")= successMessage
          form(class="mt-5 space-y-2.5", action="/registro", method="post", novalidate)
            label(class="sr-only", for="firstName") Nombres
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none placeholder:text-slate-600 focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="firstName", name="firstName", placeholder="♙  Nombres", autocomplete="given-name", required, value=values && values.firstName)
            if errors && errors.firstName
              p(class="text-xs text-rose-700", role="alert")= errors.firstName
            label(class="sr-only", for="lastName") Apellidos
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none placeholder:text-slate-600 focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="lastName", name="lastName", placeholder="♙  Apellidos", autocomplete="family-name", required, value=values && values.lastName)
            if errors && errors.lastName
              p(class="text-xs text-rose-700", role="alert")= errors.lastName
            label(class="sr-only", for="documentType") Tipo de documento
            select(class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="documentType", name="documentType", required)
              option(value="") Tipo de documento
              option(value="CC", selected=values && values.documentType === "CC") Cédula de ciudadanía
              option(value="CE", selected=values && values.documentType === "CE") Cédula de extranjería
              option(value="PASSPORT", selected=values && values.documentType === "PASSPORT") Pasaporte
            if errors && errors.documentType
              p(class="text-xs text-rose-700", role="alert")= errors.documentType
            label(class="sr-only", for="documentNumber") Número de documento
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none placeholder:text-slate-600 focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="documentNumber", name="documentNumber", placeholder="Número de documento", autocomplete="off", required, value=values && values.documentNumber)
            if errors && errors.documentNumber
              p(class="text-xs text-rose-700", role="alert")= errors.documentNumber
            label(class="sr-only", for="dateOfBirth") Fecha de nacimiento
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="dateOfBirth", name="dateOfBirth", type="date", autocomplete="bday", required, value=values && values.dateOfBirth, aria-label="Fecha de nacimiento")
            if errors && errors.dateOfBirth
              p(class="text-xs text-rose-700", role="alert")= errors.dateOfBirth
            label(class="sr-only", for="email") Correo electrónico
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none placeholder:text-slate-600 focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="email", name="email", type="email", placeholder="✉  Correo electrónico", autocomplete="email", required, value=values && values.email)
            if errors && errors.email
              p(class="text-xs text-rose-700", role="alert")= errors.email
            label(class="sr-only", for="phone") Teléfono
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none placeholder:text-slate-600 focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="phone", name="phone", type="tel", placeholder="☎  Teléfono", autocomplete="tel", required, value=values && values.phone)
            if errors && errors.phone
              p(class="text-xs text-rose-700", role="alert")= errors.phone
            label(class="sr-only", for="password") Contraseña
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none placeholder:text-slate-600 focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="password", name="password", type="password", placeholder="Contraseña", autocomplete="new-password", required)
            if errors && errors.password
              p(class="text-xs text-rose-700", role="alert")= errors.password
            label(class="sr-only", for="passwordConfirmation") Confirmar contraseña
            input(class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none placeholder:text-slate-600 focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="passwordConfirmation", name="passwordConfirmation", type="password", placeholder="Confirmar contraseña", autocomplete="new-password", required)
            if errors && errors.passwordConfirmation
              p(class="text-xs text-rose-700", role="alert")= errors.passwordConfirmation
            div(class="pt-1")
              label(class="flex items-start gap-2 text-xs leading-5 text-slate-700")
                input(class="mt-1 accent-medigo-blue", type="checkbox", name="privacyAccepted", required, checked=values && values.privacyAccepted)
                span Acepto los
                  |  #[a(class="font-semibold text-medigo-blue underline", href="/terminos") Términos y Condiciones]
                  |  y la #[a(class="font-semibold text-medigo-blue underline", href="/privacidad") Política de Privacidad]
              if errors && errors.privacyAccepted
                p(class="mt-1 text-xs text-rose-700", role="alert")= errors.privacyAccepted
            button(class="w-full rounded-lg bg-medigo-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue focus:ring-offset-2", type="submit") Registrarse
          p(class="mt-4 text-center text-xs text-slate-700") ¿Ya tienes cuenta? #[a(class="font-semibold text-medigo-blue underline", href="/iniciar-sesion") Inicia sesión]

