extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto flex min-h-screen max-w-xl items-center px-4 py-10")
    section(class="w-full rounded-2xl bg-white p-8 shadow-lg ring-1 ring-slate-200 sm:p-10")
      p(class="text-center text-sm font-semibold uppercase tracking-widest text-medigo-blue") MediGo
      h1(class="mt-3 text-center text-2xl font-bold text-medigo-navy")= title
      if message
        p(class="mt-5 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900", role="status")= message
      else
        p(class="mt-4 text-center text-slate-700") Escribe el correo asociado a tu cuenta. Te enviaremos un enlace para crear otra contraseña.
        form(class="mt-6 space-y-4", action="/recuperar-contrasena", method="post")
          input(type="hidden", name="_csrf", value=csrfToken)
          div
            label(class="mb-1 block text-sm font-medium text-medigo-navy", for="email") Correo electrónico
            input(class="w-full rounded-lg border border-slate-300 px-3 py-2.5 outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="email", name="email", type="email", autocomplete="email", required, maxlength="254", value=email)
          button(class="w-full rounded-lg bg-medigo-blue px-4 py-2.5 font-semibold text-white hover:bg-medigo-navy focus:outline-none focus:ring-2 focus:ring-medigo-blue focus:ring-offset-2", type="submit") Enviar enlace
      a(class="mt-6 block text-center text-sm font-semibold text-medigo-blue underline", href="/iniciar-sesion") Volver a iniciar sesión
