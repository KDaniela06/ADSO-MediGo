extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto flex min-h-screen max-w-xl items-center px-4 py-10")
    section(class="w-full rounded-2xl bg-white p-8 shadow-lg ring-1 ring-slate-200 sm:p-10")
      p(class="text-center text-sm font-semibold uppercase tracking-widest text-medigo-blue") MediGo
      h1(class="mt-3 text-center text-2xl font-bold text-medigo-navy") Configura tu cuenta médica
      if firstName
        p(class="mt-3 text-center text-slate-700") Hola #{firstName}, crea tu contraseña para activar el acceso.
      if message
        p(class="mt-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900", role="alert")= message
      else
        p(class="mt-4 text-center text-sm text-slate-600") La contraseña debe tener al menos 8 caracteres. Este enlace se utiliza una sola vez.
        form(class="mt-6 space-y-4", action="/invitacion-medico/" + encodeURIComponent(token), method="post")
          input(type="hidden", name="_csrf", value=csrfToken)
          div
            label(class="mb-1 block text-sm font-medium text-medigo-navy", for="password") Contraseña
            input(class="w-full rounded-lg border border-slate-300 px-3 py-2.5", id="password", name="password", type="password", autocomplete="new-password", required, minlength="8")
            if errors.password
              p(class="mt-1 text-sm text-rose-700", role="alert")= errors.password
          div
            label(class="mb-1 block text-sm font-medium text-medigo-navy", for="passwordConfirmation") Confirmar contraseña
            input(class="w-full rounded-lg border border-slate-300 px-3 py-2.5", id="passwordConfirmation", name="passwordConfirmation", type="password", autocomplete="new-password", required, minlength="8")
            if errors.passwordConfirmation
              p(class="mt-1 text-sm text-rose-700", role="alert")= errors.passwordConfirmation
          button(class="w-full rounded-lg bg-medigo-blue px-4 py-2.5 font-semibold text-white hover:bg-medigo-navy", type="submit") Configurar mi cuenta
      a(class="mt-6 block text-center text-sm font-semibold text-medigo-blue underline", href="/iniciar-sesion") Ir al inicio de sesión
