extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto flex min-h-screen max-w-xl items-center px-4 py-10")
    section(class="w-full rounded-2xl bg-white p-8 text-center shadow-lg ring-1 ring-slate-200 sm:p-10")
      p(class="text-sm font-semibold uppercase tracking-widest text-medigo-blue") MediGo
      h1(class="mt-3 text-2xl font-bold text-medigo-navy")= title
      p(class="mt-4 text-slate-700", role="status")= message
      a(class="mt-6 inline-block text-sm font-semibold text-medigo-blue underline", href="/iniciar-sesion") Iniciar sesión
