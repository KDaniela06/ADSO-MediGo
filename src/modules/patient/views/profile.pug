extends ../../../views/shared/layout.pug

block content
  main.patient-profile-page
    section.patient-profile-card(aria-labelledby="patient-profile-title")
      header.patient-profile-heading
        span.patient-profile-heading-icon(aria-hidden="true")
          svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round")
            rect(x="3", y="4", width="18", height="16", rx="2")
            path(d="M7 8h4m-4 4h10m-10 4h7")
        div
          h2#patient-profile-title Mi Perfil
          p Consulta y actualiza tu información.

      if message
        p.patient-profile-message(role="status")= message
      if profile.pendingEmail
        p.patient-profile-pending Tienes pendiente confirmar #{profile.pendingEmail}. Tu correo actual sigue activo hasta que confirmes el enlace.

      .patient-profile-person
        .patient-profile-avatar(aria-label="Iniciales del paciente")
          span(aria-hidden="true") #{(profile.firstName || "P")[0]}#{(profile.lastName || "")[0] || ""}
        div
          h3 #{profile.firstName || ""} #{profile.lastName || ""}
          p.patient-profile-verified
            span.patient-profile-check(aria-hidden="true") ✓
            span Cuenta verificada

      form(action="/perfil", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        .patient-profile-form
          fieldset
            legend Información personal
            .patient-profile-fields
              div.patient-profile-field
                label(for="firstName") Nombres
                div
                  input#firstName(name="firstName", value=values.firstName || "", required, maxlength="100", autocomplete="given-name")
                  if errors.firstName
                    p.patient-profile-error(role="alert")= errors.firstName
              div.patient-profile-field
                label(for="lastName") Apellidos
                div
                  input#lastName(name="lastName", value=values.lastName || "", required, maxlength="100", autocomplete="family-name")
                  if errors.lastName
                    p.patient-profile-error(role="alert")= errors.lastName
              div.patient-profile-field
                span Documento
                span.patient-profile-readonly #{profile.documentType || ""} · #{profile.documentNumber || ""}
              div.patient-profile-field
                span Fecha de nacimiento
                span.patient-profile-readonly #{profile.dateOfBirth ? profile.dateOfBirth.split("-").reverse().join("/") : ""}

          fieldset.patient-contact-fieldset
            legend Información de contacto
            .patient-contact-fields
              div.patient-profile-field
                label(for="email") Correo electrónico
                div
                  input#email(name="email", type="email", value=values.email || "", required, maxlength="254", autocomplete="email")
                  if errors.email
                    p.patient-profile-error(role="alert")= errors.email
              div.patient-profile-field
                label(for="phone") Celular
                div
                  input#phone(name="phone", type="tel", value=values.phone || "", required, maxlength="30", autocomplete="tel")
                  if errors.phone
                    p.patient-profile-error(role="alert")= errors.phone
              div.patient-profile-field
                label(for="city") Ciudad (opcional)
                div
                  input#city(name="city", value=values.city || "", maxlength="100", autocomplete="address-level2")
                  if errors.city
                    p.patient-profile-error(role="alert")= errors.city

        button.patient-profile-save(type="submit") Guardar cambios

      a.patient-profile-password(href="/cambiar-contrasena")
        span.patient-profile-password-icon(aria-hidden="true")
          svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round")
            rect(x="4", y="10", width="16", height="11", rx="2")
            path(d="M8 10V7a4 4 0 1 1 8 0v3m-4 4v3")
        span Cambiar contraseña
        svg.patient-profile-password-arrow(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
          path(d="m9 18 6-6-6-6")
