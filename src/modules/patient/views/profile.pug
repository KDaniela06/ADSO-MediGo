extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto min-h-screen max-w-4xl px-4 py-10 sm:px-6")
    header(class="flex items-center justify-between border-b border-slate-200 pb-5")
      a(class="text-2xl font-extrabold text-medigo-navy", href="/paciente") Medi#[span(class="text-medigo-cyan") Go]
      a(class="text-sm font-semibold text-medigo-blue underline", href="/paciente") Volver a mi espacio
    section(class="mt-8 rounded-2xl bg-white p-6 shadow-lg ring-1 ring-slate-200 sm:p-9")
      p(class="text-sm font-semibold uppercase tracking-widest text-medigo-blue") Área de paciente
      h1(class="mt-2 text-3xl font-bold text-medigo-navy") Mi perfil
      p(class="mt-2 text-slate-600") Consulta tus datos y actualiza tu información de contacto.
      if message
        p(class="mt-5 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900", role="status")= message
      if profile.pendingEmail
        p(class="mt-3 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900") Tienes pendiente confirmar #{profile.pendingEmail}. Tu correo actual sigue activo hasta que confirmes el enlace.
      form(class="mt-7 grid gap-5 sm:grid-cols-2", action="/perfil", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        div
          label(class="mb-1 block text-sm font-medium text-medigo-navy", for="documentType") Tipo de documento
          input(class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-slate-600", id="documentType", value=profile.documentType || "", readonly, aria-describedby="identity-note")
        div
          label(class="mb-1 block text-sm font-medium text-medigo-navy", for="documentNumber") Número de documento
          input(class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-slate-600", id="documentNumber", value=profile.documentNumber || "", readonly, aria-describedby="identity-note")
        p(class="text-xs text-slate-500 sm:col-span-2", id="identity-note") Los datos de identificación no se pueden cambiar desde esta pantalla.
        div
          label(class="mb-1 block text-sm font-medium text-medigo-navy", for="firstName") Nombres
          input(class="w-full rounded-lg border border-slate-300 px-3 py-2.5 outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="firstName", name="firstName", value=values.firstName || "", required, maxlength="100", autocomplete="given-name")
          if errors.firstName
            p(class="mt-1 text-sm text-rose-700", role="alert")= errors.firstName
        div
          label(class="mb-1 block text-sm font-medium text-medigo-navy", for="lastName") Apellidos
          input(class="w-full rounded-lg border border-slate-300 px-3 py-2.5 outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="lastName", name="lastName", value=values.lastName || "", required, maxlength="100", autocomplete="family-name")
          if errors.lastName
            p(class="mt-1 text-sm text-rose-700", role="alert")= errors.lastName
        div
          label(class="mb-1 block text-sm font-medium text-medigo-navy", for="phone") Teléfono
          input(class="w-full rounded-lg border border-slate-300 px-3 py-2.5 outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="phone", name="phone", type="tel", value=values.phone || "", required, maxlength="30", autocomplete="tel")
          if errors.phone
            p(class="mt-1 text-sm text-rose-700", role="alert")= errors.phone
        div
          label(class="mb-1 block text-sm font-medium text-medigo-navy", for="email") Correo electrónico
          input(class="w-full rounded-lg border border-slate-300 px-3 py-2.5 outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="email", name="email", type="email", value=values.email || "", required, maxlength="254", autocomplete="email")
          if errors.email
            p(class="mt-1 text-sm text-rose-700", role="alert")= errors.email
          p(class="mt-1 text-xs text-slate-500") Para cambiarlo, confirma el enlace que enviaremos al nuevo correo.
        if profile.dateOfBirth
          div
            label(class="mb-1 block text-sm font-medium text-medigo-navy", for="dateOfBirth") Fecha de nacimiento
            input(class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-slate-600", id="dateOfBirth", value=profile.dateOfBirth, readonly)
        div(class="sm:col-span-2")
          button(class="rounded-lg bg-medigo-blue px-5 py-2.5 font-semibold text-white hover:bg-medigo-navy focus:outline-none focus:ring-2 focus:ring-medigo-blue focus:ring-offset-2", type="submit") Guardar cambios
