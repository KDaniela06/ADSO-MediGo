extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 lg:flex")
    aside(class="bg-medigo-navy text-white lg:flex lg:w-64 lg:flex-col")
      a(class="flex items-center gap-3 px-6 py-5 text-2xl font-extrabold", href="/paciente", aria-label="MediGo, inicio")
        span(class="flex h-11 w-11 items-center justify-center rounded-xl bg-medigo-cyan text-2xl", aria-hidden="true") ✚
        span Medi#[span(class="text-medigo-cyan") Go]
      nav(class="flex gap-1 overflow-x-auto px-3 pb-3 lg:block lg:flex-1 lg:space-y-1 lg:px-3 lg:py-5", aria-label="Navegación principal")
        a(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-sky-100 hover:bg-white/10", href="/paciente")
          span(class="w-5 text-center", aria-hidden="true") ⌂
          span Inicio
        button(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 opacity-70", type="button", disabled, title="Disponible próximamente")
          span(class="w-5 text-center", aria-hidden="true") ▣
          span Mis citas
        a(class="flex shrink-0 items-center gap-3 rounded-xl bg-medigo-cyan px-4 py-3 text-sm font-semibold text-white", href="/perfil", aria-current="page")
          span(class="w-5 text-center", aria-hidden="true") ●
          span Mi perfil
        button(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 opacity-70", type="button", disabled, title="Disponible próximamente")
          span(class="w-5 text-center", aria-hidden="true") ◉
          span WhatsApp
      form(class="hidden border-t border-white/15 p-4 lg:block", action="/cerrar-sesion", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        button(class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 hover:bg-white/10", type="submit")
          span(class="w-5 text-center", aria-hidden="true") ⇥
          span Cerrar sesión
    section(class="min-w-0 flex-1")
      header(class="flex h-16 items-center justify-end gap-4 border-b border-slate-200 bg-white px-5 sm:px-8")
        button(class="relative rounded-full p-2 text-slate-600 hover:bg-slate-100", type="button", aria-label="Notificaciones")
          span(aria-hidden="true") ♧
          span(class="absolute right-1 top-1 h-2 w-2 rounded-full bg-medigo-cyan")
        form(class="lg:hidden", action="/cerrar-sesion", method="post")
          input(type="hidden", name="_csrf", value=csrfToken)
          button(class="rounded-lg border border-medigo-blue px-3 py-2 text-xs font-semibold text-medigo-blue", type="submit") Salir
        div(class="flex items-center gap-2")
          span(class="flex h-9 w-9 items-center justify-center rounded-full bg-medigo-blue text-sm font-semibold text-white") #{(profile.firstName || "P")[0]}#{(profile.lastName || "")[0] || ""}
          span(class="hidden text-sm font-medium text-medigo-navy sm:block") #{profile.firstName || ""} #{profile.lastName || ""}
          span(class="text-slate-500", aria-hidden="true") ▾
      div(class="mx-auto max-w-5xl px-4 py-8 sm:px-8")
        div(class="mb-6 flex items-center gap-3")
          span(class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-xl text-medigo-blue", aria-hidden="true") ▣
          div
            h1(class="text-2xl font-bold text-medigo-navy") Mi Perfil
            p(class="mt-1 text-sm text-slate-600") Consulta y actualiza tu información.
        section(class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-8")
          if message
            p(class="mb-5 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900", role="status")= message
          if profile.pendingEmail
            p(class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900") Tienes pendiente confirmar #{profile.pendingEmail}. Tu correo actual sigue activo hasta que confirmes el enlace.
          div(class="mb-7 flex items-center gap-5 border-b border-slate-100 pb-6")
            div(class="relative flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-sky-100 text-4xl font-semibold text-medigo-blue", aria-label="Foto de perfil")
              span(aria-hidden="true") #{(profile.firstName || "P")[0]}#{(profile.lastName || "")[0] || ""}
            div
              h2(class="text-xl font-bold text-medigo-navy") #{profile.firstName || ""} #{profile.lastName || ""}
              p(class="mt-1 inline-flex items-center gap-1.5 text-sm text-emerald-700")
                span(class="text-lg", aria-hidden="true") ✓
                span Cuenta verificada
          form(action="/perfil", method="post")
            input(type="hidden", name="_csrf", value=csrfToken)
            div(class="grid gap-x-10 gap-y-7 md:grid-cols-2")
              fieldset
                legend(class="mb-3 text-base font-bold text-medigo-navy") Información personal
                div(class="space-y-3")
                  div(class="grid grid-cols-[130px_1fr] items-center gap-3")
                    label(class="text-sm text-slate-700", for="firstName") Nombres
                    div
                      input(class="w-full border-0 border-b border-slate-200 bg-transparent px-1 py-1 text-sm text-medigo-navy outline-none focus:border-medigo-blue focus:ring-0", id="firstName", name="firstName", value=values.firstName || "", required, maxlength="100", autocomplete="given-name")
                      if errors.firstName
                        p(class="mt-1 text-xs text-rose-700", role="alert")= errors.firstName
                  div(class="grid grid-cols-[130px_1fr] items-center gap-3")
                    label(class="text-sm text-slate-700", for="lastName") Apellidos
                    div
                      input(class="w-full border-0 border-b border-slate-200 bg-transparent px-1 py-1 text-sm text-medigo-navy outline-none focus:border-medigo-blue focus:ring-0", id="lastName", name="lastName", value=values.lastName || "", required, maxlength="100", autocomplete="family-name")
                      if errors.lastName
                        p(class="mt-1 text-xs text-rose-700", role="alert")= errors.lastName
                  div(class="grid grid-cols-[130px_1fr] items-center gap-3")
                    span(class="text-sm text-slate-700") Documento
                    span(class="text-sm text-medigo-navy") #{profile.documentType || ""} · #{profile.documentNumber || ""}
                  div(class="grid grid-cols-[130px_1fr] items-center gap-3")
                    span(class="text-sm text-slate-700") Fecha de nacimiento
                    span(class="text-sm text-medigo-navy") #{profile.dateOfBirth ? profile.dateOfBirth.split("-").reverse().join("/") : ""}
              fieldset
                legend(class="mb-3 text-base font-bold text-medigo-navy") Información de contacto
                div(class="overflow-hidden rounded-xl border border-slate-200")
                  div(class="grid grid-cols-[130px_1fr] items-center gap-3 border-b border-slate-100 px-3 py-3")
                    label(class="text-sm text-slate-700", for="email") Correo electrónico
                    div
                      input(class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm text-medigo-navy outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="email", name="email", type="email", value=values.email || "", required, maxlength="254", autocomplete="email")
                      if errors.email
                        p(class="mt-1 text-xs text-rose-700", role="alert")= errors.email
                  div(class="grid grid-cols-[130px_1fr] items-center gap-3 border-b border-slate-100 px-3 py-3")
                    label(class="text-sm text-slate-700", for="phone") Celular
                    div
                      input(class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm text-medigo-navy outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="phone", name="phone", type="tel", value=values.phone || "", required, maxlength="30", autocomplete="tel")
                      if errors.phone
                        p(class="mt-1 text-xs text-rose-700", role="alert")= errors.phone
                  div(class="grid grid-cols-[130px_1fr] items-center gap-3 px-3 py-3")
                    label(class="text-sm text-slate-700", for="city") Ciudad (opcional)
                    div
                      input(class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm text-medigo-navy outline-none focus:border-medigo-blue focus:ring-2 focus:ring-medigo-blue/20", id="city", name="city", value=values.city || "", maxlength="100", autocomplete="address-level2")
                      if errors.city
                        p(class="mt-1 text-xs text-rose-700", role="alert")= errors.city
            button(class="mt-7 w-full rounded-lg bg-medigo-blue px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-medigo-navy focus:outline-none focus:ring-2 focus:ring-medigo-blue focus:ring-offset-2", type="submit") Guardar cambios
          button(class="mt-4 flex w-full cursor-not-allowed items-center justify-between rounded-xl border border-slate-200 px-4 py-3 text-left text-sm font-semibold text-medigo-navy", type="button", disabled, title="Disponible en una próxima actualización")
            span(class="flex items-center gap-3")
              span(class="text-medigo-blue", aria-hidden="true") ◈
              span Cambiar contraseña
            span(class="text-lg text-slate-500", aria-hidden="true") ›
