extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto flex min-h-screen max-w-xl items-center px-4 py-10")
    section(class="w-full rounded-2xl bg-white p-8 text-center shadow-lg ring-1 ring-slate-200 sm:p-10")
      p(class="text-sm font-semibold uppercase tracking-widest text-medigo-blue") MediGo
      h1(class="mt-3 text-2xl font-bold text-medigo-navy")= title
      if message
        p(class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900", role="alert")= message
        a(class="mt-6 inline-block text-sm font-semibold text-medigo-blue underline", href="/iniciar-sesion") Volver a iniciar sesión
      else
        p(class="mt-4 text-slate-700") Confirma que quieres usar este correo en tu cuenta. El correo actual seguirá activo hasta completar este paso.
        form(class="mt-6", action="/confirmar-cambio-correo/" + encodeURIComponent(token), method="post")
          input(type="hidden", name="_csrf", value=csrfToken)
          button(class="rounded-lg bg-medigo-blue px-5 py-2.5 font-semibold text-white hover:bg-medigo-navy", type="submit") Confirmar nuevo correo
