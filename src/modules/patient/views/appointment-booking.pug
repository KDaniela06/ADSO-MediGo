extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-50 px-4 py-8 text-slate-800")
    section(class="mx-auto max-w-5xl")
      header
        h1(class="mt-1 text-2xl font-bold text-medigo-navy") Reservar una cita
        p(class="mt-1 text-sm text-slate-600") Elige especialidad, médico, fecha y horario. Las citas duran 30 minutos.
      if message
        p(class="mt-4 rounded-xl bg-sky-50 p-4 text-sm text-sky-900", role="status")= message
      if page.status === "error" || page.status === "unavailable"
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No pudimos cargar la disponibilidad. Inténtalo de nuevo más tarde.
      else if page.patientHasUpcoming && !booking
        section(class="mt-5 rounded-2xl border border-sky-200 bg-sky-50 p-5")
          h2(class="font-bold text-medigo-navy") Ya tienes una cita futura confirmada
          p(class="mt-1 text-sm text-slate-700") Puedes tener una sola cita confirmada a la vez. Consulta la información en Mis citas.
          a(class="mt-3 inline-flex rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/mis-citas") Ir a Mis citas
      if booking && booking.status === "booked"
        section(class="mt-5 rounded-2xl border border-emerald-200 bg-white p-6 shadow-sm", role="status")
          p(class="text-sm font-semibold uppercase tracking-wide text-emerald-700") Cita confirmada
          h2(class="mt-1 text-xl font-bold text-medigo-navy") #{booking.doctor.specialtyName} · Dr(a). #{booking.doctor.name}
          p(class="mt-2 text-sm text-slate-700") #{booking.appointment.date} a las #{booking.appointment.time}
          if booking.notificationStatus === "sent"
            p(class="mt-3 text-sm text-emerald-800") Envié los detalles a tu correo.
          else
            p(class="mt-3 text-sm text-amber-800") La cita está guardada, pero no pude enviar el correo de confirmación.
          a(class="mt-4 inline-flex rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/mis-citas") Ir a mis citas
      else if !page.patientHasUpcoming
        section(class="mt-5 space-y-5")
          article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
            div(class="mb-4 flex items-center gap-2")
              span(class="flex h-8 w-8 items-center justify-center rounded-full bg-medigo-blue text-sm font-bold text-white") 1
              h2(class="font-bold text-medigo-navy") Selecciona una especialidad
            form(class="flex flex-wrap items-end gap-3", action="/citas/reservar", method="get")
              div(class="min-w-64 flex-1")
                label(class="mb-1 block text-sm font-semibold", for="specialtyId") Especialidad
                select#specialtyId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="specialtyId", required)
                  option(value="") Selecciona una especialidad
                  each specialty in page.specialties
                    option(value=specialty.id, selected=String(page.selectedSpecialtyId) === String(specialty.id))= specialty.name
              button(class="rounded-lg bg-medigo-blue px-4 py-2 font-semibold text-white", type="submit") Continuar
          if page.selectedSpecialty
            article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
              div(class="mb-4 flex items-center gap-2")
                span(class="flex h-8 w-8 items-center justify-center rounded-full bg-medigo-blue text-sm font-bold text-white") 2
                h2(class="font-bold text-medigo-navy") Selecciona un médico
              form(class="flex flex-wrap items-end gap-3", action="/citas/reservar", method="get")
                input(type="hidden", name="specialtyId", value=page.selectedSpecialtyId)
                div(class="min-w-64 flex-1")
                  label(class="mb-1 block text-sm font-semibold", for="doctorId") Médico
                  select#doctorId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="doctorId", required)
                    option(value="") Selecciona un médico
                    each doctor in page.doctors
                      option(value=doctor.id, selected=String(page.selectedDoctorId) === String(doctor.id))= doctor.name
                button(class="rounded-lg bg-medigo-blue px-4 py-2 font-semibold text-white", type="submit") Continuar
          if page.selectedDoctor
            article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
              div(class="mb-4 flex items-center gap-2")
                span(class="flex h-8 w-8 items-center justify-center rounded-full bg-medigo-blue text-sm font-bold text-white") 3
                h2(class="font-bold text-medigo-navy") Elige fecha y horario
              form(class="flex flex-wrap items-end gap-3", action="/citas/reservar", method="get")
                input(type="hidden", name="specialtyId", value=page.selectedSpecialtyId)
                input(type="hidden", name="doctorId", value=page.selectedDoctorId)
                div(class="min-w-64 flex-1")
                  label(class="mb-1 block text-sm font-semibold", for="date") Fecha
                  input#date(class="w-full rounded-lg border border-slate-300 px-3 py-2", type="date", name="date", min=page.minDate, max=page.maxDate, value=page.date, required)
                button(class="rounded-lg bg-medigo-blue px-4 py-2 font-semibold text-white", type="submit") Buscar horarios
              if page.date && page.status === "invalid_date"
                p(class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900", role="alert") Selecciona una fecha dentro de los próximos 30 días.
              else if page.date && page.slots.length
                form(class="mt-4", action="/citas/reservar", method="get")
                  input(type="hidden", name="specialtyId", value=page.selectedSpecialtyId)
                  input(type="hidden", name="doctorId", value=page.selectedDoctorId)
                  input(type="hidden", name="date", value=page.date)
                  fieldset
                    legend(class="mb-3 text-sm font-semibold") Horarios disponibles · 30 minutos
                    div(class="grid grid-cols-2 gap-2 sm:grid-cols-4")
                      each slot in page.slots
                        label(class="cursor-pointer rounded-lg border border-slate-300 px-3 py-2 text-center text-sm hover:border-medigo-blue")
                          input(class="sr-only", type="radio", name="time", value=slot.time, checked=page.time === slot.time, required)
                          span= slot.label
                  button(class="mt-4 rounded-lg bg-medigo-blue px-4 py-2 font-semibold text-white", type="submit") Revisar cita
              else if page.date
                p(class="mt-3 rounded-lg bg-slate-50 p-3 text-sm text-slate-600") No hay horarios disponibles para esta fecha. Prueba con otro día.
              if page.selectedSlot
                div(class="mt-5 rounded-xl bg-sky-50 p-4")
                  div(class="mb-3 flex items-center gap-2")
                    span(class="flex h-8 w-8 items-center justify-center rounded-full bg-medigo-blue text-sm font-bold text-white") 4
                    h2(class="font-bold text-medigo-navy") Revisa y confirma
                  p(class="text-sm text-slate-700") #{page.selectedSpecialty.name} · Dr(a). #{page.selectedDoctor.name}
                  p(class="mt-1 text-sm text-slate-700") #{page.date} · #{page.selectedSlot.label} · 30 minutos
                  form(class="mt-4", action="/citas/reservar/confirmar", method="post")
                    input(type="hidden", name="_csrf", value=csrfToken)
                    input(type="hidden", name="specialtyId", value=page.selectedSpecialtyId)
                    input(type="hidden", name="doctorId", value=page.selectedDoctorId)
                    input(type="hidden", name="date", value=page.date)
                    input(type="hidden", name="time", value=page.time)
                    button(class="rounded-lg bg-medigo-blue px-5 py-3 font-semibold text-white", type="submit") Confirmar reserva
