button.patient-sidebar-overlay.hidden(type="button", data-sidebar-overlay, aria-label="Cerrar menú de navegación")
aside#patient-sidebar.patient-sidebar.fixed.inset-y-0.left-0.z-40.flex.h-screen.w-64.shrink-0.flex-col.bg-medigo-navy.text-white.shadow-xl(data-patient-sidebar, data-open="false", aria-label="Navegación del paciente")
  .patient-sidebar-brand
    a.patient-brand(href="/paciente", aria-label="MediGo, inicio")
      span.patient-brand-mark(aria-hidden="true")
        svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 48 48", fill="none", class="h-8 w-8")
          rect(x="2", y="2", width="44", height="44", rx="15", fill="currentColor", opacity=".18")
          path(d="M24 11v26M11 24h26", stroke="currentColor", stroke-width="4", stroke-linecap="round")
          circle(cx="24", cy="24", r="17", stroke="currentColor", stroke-width="2")
      span.patient-sidebar-label.patient-brand-name Medi#[span(class="text-medigo-cyan") Go]
    button.patient-menu-toggle(type="button", data-sidebar-toggle, aria-controls="patient-sidebar-menu", aria-label="Contraer menú", aria-expanded="true", title="Contraer menú")
      svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.9", stroke-linecap="round", class="h-6 w-6", aria-hidden="true")
        path(d="M4 6h16M4 12h16M4 18h16")
  .patient-sidebar-menu#patient-sidebar-menu
    p.patient-sidebar-label.patient-sidebar-caption Navegación
    nav.patient-sidebar-nav(aria-label="Secciones del paciente")
      each item in patientNavigationItems
        a.patient-nav-link(class=item.id === activePatientPage ? "is-active" : "", href=item.href, title=item.label, aria-current=item.id === activePatientPage ? "page" : undefined)
          span.patient-nav-icon(aria-hidden="true")
            case item.icon
              when "home"
                svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-5 w-5")
                  path(d="m3 10 9-7 9 7")
                  path(d="M5 9v11h14V9M9 20v-6h6v6")
              when "calendar"
                svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-5 w-5")
                  rect(x="3", y="5", width="18", height="16", rx="3")
                  path(d="M16 3v4M8 3v4M3 10h18m-13 4h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01")
              when "appointments"
                svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-5 w-5")
                  rect(x="4", y="4", width="16", height="17", rx="3")
                  path(d="M8 2v4m8-4v4M8 11h8M8 15h5")
              when "history"
                svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-5 w-5")
                  path(d="M3 12a9 9 0 1 0 2.6-6.4L3 8")
                  path(d="M3 3v5h5m4-1v5l3 2")
              when "profile"
                svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-5 w-5")
                  circle(cx="12", cy="8", r="4")
                  path(d="M4 21a8 8 0 0 1 16 0")
              when "whatsapp"
                svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-5 w-5")
                  path(d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z")
                  path(d="M9 9.5c.5 2 2 3.5 4 4l1-1 2 1c-.3 1.2-1.2 2-2.5 2-3.2-.2-6.8-3.8-7-7 0-1.3.8-2.2 2-2.5l1 2-1.5 1.5Z")
          span.patient-sidebar-label.patient-nav-label= item.label

    .patient-sidebar-bottom
      button.patient-nav-link.patient-logout-trigger(type="button", data-open-logout, title="Cerrar sesión")
        span.patient-nav-icon(aria-hidden="true")
          svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-5 w-5")
            path(d="M10 17l5-5-5-5m5 5H3")
            path(d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6")
        span.patient-sidebar-label.patient-nav-label Cerrar sesión
      p.patient-sidebar-label.patient-sidebar-footer Tu salud, en buenas manos
