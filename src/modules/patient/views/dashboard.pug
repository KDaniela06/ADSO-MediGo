extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto min-h-screen max-w-5xl px-4 py-10 sm:px-6")
    header(class="flex items-center justify-between border-b border-slate-200 pb-5")
      a(class="text-2xl font-extrabold text-medigo-navy", href="/") Medi#[span(class="text-medigo-cyan") Go]
      form(action="/cerrar-sesion", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        button(class="rounded-lg border border-medigo-blue px-4 py-2 text-sm font-semibold text-medigo-blue hover:bg-sky-50", type="submit") Cerrar sesión
    section(class="mt-10 rounded-2xl bg-gradient-to-r from-medigo-navy to-medigo-blue p-8 text-white sm:p-10")
      p(class="text-sm font-semibold uppercase tracking-wider text-sky-100") Área de paciente
      h1(class="mt-2 text-3xl font-bold") Hola, #{currentUser.firstName}
      p(class="mt-3 max-w-xl text-sky-50") Iniciaste sesión en MediGo. Aquí encontrarás tus opciones para gestionar tu cuenta y tus citas.
    a(class="mt-6 inline-flex rounded-lg bg-white px-5 py-3 font-semibold text-medigo-blue shadow ring-1 ring-slate-200 hover:bg-sky-50", href="/perfil") Consultar y editar mi perfil
