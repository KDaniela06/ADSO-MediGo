extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-50 text-slate-800")
    div(class="mx-auto w-full max-w-7xl px-4 py-7 sm:px-6 lg:px-8")
      header(class="mb-7 overflow-hidden rounded-3xl bg-gradient-to-r from-medigo-navy via-medigo-blue to-sky-500 px-6 py-7 text-white shadow-lg sm:px-9 sm:py-9")
        .flex.flex-wrap.items-center.justify-between.gap-5
          div
            h1(class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl") Hola, #{currentUser.firstName}
            p(class="mt-2 max-w-xl text-sm leading-6 text-sky-50 sm:text-base") Tu espacio de salud está listo. Consulta tus citas y administra tu cuenta desde aquí.
          span(class="hidden h-20 w-20 items-center justify-center rounded-3xl border border-white/25 bg-white/10 sm:flex", aria-hidden="true")
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 48 48", fill="none", class="h-12 w-12 text-white")
              path(d="M24 5v38M5 24h38", stroke="currentColor", stroke-width="5", stroke-linecap="round")
              circle(cx="24", cy="24", r="19", stroke="currentColor", stroke-width="2")

      div(class="mt-6 grid gap-5 lg:grid-cols-3")
        section(aria-labelledby="next-appointment-title", class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2 sm:p-6")
          .flex.items-center.justify-between.gap-3
            h2#next-appointment-title(class="text-xl font-bold text-medigo-navy") Próximas citas
            a(href="/mis-citas", class="whitespace-nowrap text-sm font-semibold text-medigo-blue hover:underline") Ver todas →
          if dashboard && dashboard.status === "ready" && dashboard.appointment
            article(class="mt-5 flex flex-col gap-4 rounded-2xl border border-sky-100 bg-gradient-to-r from-sky-50 to-white p-4 sm:flex-row sm:items-center sm:p-5")
              div(class="min-w-20 rounded-xl bg-white px-3 py-2 text-center text-sm font-semibold capitalize text-medigo-blue shadow-sm ring-1 ring-sky-100")
                span(class="block") #{dashboard.appointment.date}
                span(class="mt-1 block text-slate-600") #{dashboard.appointment.time}
              div(class="flex-1")
                h3(class="font-bold text-medigo-navy") #{dashboard.appointment.specialtyName}
                p(class="mt-1 text-sm text-slate-600") Dr(a). #{dashboard.appointment.doctorName}
              span(class="w-fit rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800") #{dashboard.appointment.status}
          else if dashboard && dashboard.status === "error"
            p(role="alert", class="mt-5 rounded-xl bg-amber-50 p-4 text-sm text-amber-900") No pudimos cargar tus citas. Inténtalo de nuevo más tarde.
          else
            div(class="mt-5 rounded-2xl bg-sky-50 p-5")
              h3(class="font-semibold text-medigo-navy") Aún no tienes citas próximas
              p(class="mt-1 text-sm text-slate-600") Cuando reserves una cita, podrás consultar aquí su fecha y los datos del médico.
              a(href="/citas/reservar", class="mt-4 inline-flex rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white hover:bg-medigo-navy") Reservar una cita

        section(aria-labelledby="help-title", class="flex flex-col justify-between overflow-hidden rounded-2xl border border-cyan-100 bg-gradient-to-br from-cyan-50 to-sky-100 p-5 sm:p-6")
          div
            span(class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-medigo-blue shadow-sm", aria-hidden="true")
              svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", stroke-linecap="round", stroke-linejoin="round", class="h-6 w-6")
                path(d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z")
                path(d="M9 9.5c.5 2 2 3.5 4 4l1-1 2 1c-.3 1.2-1.2 2-2.5 2-3.2-.2-6.8-3.8-7-7 0-1.3.8-2.2 2-2.5l1 2-1.5 1.5Z")
            h2#help-title(class="mt-4 text-xl font-bold text-medigo-navy") ¿Necesitas ayuda?
            p(class="mt-2 text-sm leading-6 text-slate-700") Vincula tu número para recibir códigos y usar MediGo por WhatsApp.
          a(href="/whatsapp/vincular", class="mt-5 inline-flex w-fit items-center gap-2 rounded-xl bg-medigo-blue px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-medigo-navy")
            span Configurar WhatsApp
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", class="h-4 w-4", aria-hidden="true")
              path(d="m9 18 6-6-6-6")
