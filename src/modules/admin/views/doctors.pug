extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-8 text-slate-800")
    section(class="mx-auto max-w-7xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador") ← Volver al panel
      header(class="mt-4 flex flex-wrap items-end justify-between gap-3")
        div
          p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
          h1(class="mt-1 text-2xl font-bold text-medigo-navy") Gestionar médicos
          p(class="mt-1 text-sm text-slate-600") Busca profesionales y revisa el estado de sus cuentas e invitaciones.
        a(class="rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/administrador/medicos/nuevo") Registrar médico
      if message === "updated"
        p(class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900", role="status") Los datos del médico se actualizaron.
      if result.status === "error"
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No pudimos cargar la lista. Inténtalo más tarde.
      else if result.status === "unavailable"
        p(class="mt-4 rounded-xl bg-sky-50 p-4 text-sm text-sky-900", role="status") La lista de médicos todavía no está disponible.
      form(class="mt-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 md:grid-cols-4", action="/administrador/medicos", method="get")
        div(class="md:col-span-2")
          label(class="sr-only", for="q") Buscar
          input#q(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="q", placeholder="Nombre, documento, correo, teléfono o registro", value=result.search)
        div
          label(class="sr-only", for="estado") Estado de cuenta
          select#estado(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="estado")
            option(value="") Todos los estados
            option(value="PENDING_VERIFICATION", selected=result.selectedStatus === "PENDING_VERIFICATION") Pendiente
            option(value="ACTIVE", selected=result.selectedStatus === "ACTIVE") Activa
            option(value="INACTIVE", selected=result.selectedStatus === "INACTIVE") Inactiva
        div
          label(class="sr-only", for="especialidad") Especialidad
          select#especialidad(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="especialidad")
            option(value="") Todas las especialidades
            each specialty in specialties
              option(value=specialty.id, selected=String(result.selectedSpecialty) === String(specialty.id))= specialty.name
        button(class="rounded-lg border border-medigo-blue px-4 py-2 text-sm font-semibold text-medigo-blue", type="submit") Aplicar filtros
      p(class="mt-4 text-sm text-slate-600")= result.total + " médicos"
      if result.doctors.length
        .mt-3.overflow-x-auto.rounded-2xl.border.border-slate-200.bg-white
          table(class="w-full min-w-[760px] text-left text-sm")
            thead(class="bg-slate-50 text-xs uppercase text-slate-500")
              tr
                th(class="px-4 py-3") Médico
                th(class="px-4 py-3") Especialidad
                th(class="px-4 py-3") Registro
                th(class="px-4 py-3") Cuenta
                th(class="px-4 py-3") Invitación
                th(class="px-4 py-3") Acciones
            tbody
              each doctor in result.doctors
                tr(class="border-t border-slate-100")
                  td(class="px-4 py-3")
                    p(class="font-semibold text-medigo-navy") #{doctor.firstName} #{doctor.lastName}
                    p(class="text-xs text-slate-500")= doctor.email
                  td(class="px-4 py-3")= doctor.specialtyName
                  td(class="px-4 py-3")= doctor.professionalRegistration
                  td(class="px-4 py-3")= doctor.accountStatus
                  td(class="px-4 py-3")= doctor.invitation.label
                  td(class="px-4 py-3")
                    a(class="font-semibold text-medigo-blue hover:underline", href="/administrador/medicos/" + doctor.id) Ver detalle
      else
        p(class="mt-3 rounded-xl bg-white p-5 text-sm text-slate-600") No encontramos médicos con esos filtros.
      if result.page > 1 || result.page < result.pageCount
        nav(class="mt-5 flex items-center justify-between", aria-label="Paginación")
          if result.page > 1
            a(class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold", href="/administrador/medicos?q=" + encodeURIComponent(result.search) + "&estado=" + result.selectedStatus + "&especialidad=" + result.selectedSpecialty + "&pagina=" + (result.page - 1)) Anterior
          else
            span
          if result.page < result.pageCount
            a(class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold", href="/administrador/medicos?q=" + encodeURIComponent(result.search) + "&estado=" + result.selectedStatus + "&especialidad=" + result.selectedSpecialty + "&pagina=" + (result.page + 1)) Siguiente
