extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto min-h-screen max-w-4xl bg-slate-100 px-4 py-8 text-slate-800")
    a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/medicos") ← Volver a médicos
    section(class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8")
      p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
      h1(class="mt-1 text-2xl font-bold text-medigo-navy") Detalle del médico
      if message === "updated"
        p(class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900", role="status") Los datos del médico se actualizaron.
      div(class="mt-5 grid gap-4 sm:grid-cols-2")
        div
          p(class="text-xs uppercase text-slate-500") Nombres
          p(class="mt-1 font-semibold") #{doctor.firstName} #{doctor.lastName}
        div
          p(class="text-xs uppercase text-slate-500") Documento
          p(class="mt-1 font-semibold") #{doctor.documentType} #{doctor.documentNumber}
        div
          p(class="text-xs uppercase text-slate-500") Correo
          p(class="mt-1 font-semibold")= doctor.email
          if doctor.pendingEmail
            p(class="mt-1 text-xs text-amber-800") Correo pendiente de confirmar: #{doctor.pendingEmail}
        div
          p(class="text-xs uppercase text-slate-500") Teléfono
          p(class="mt-1 font-semibold")= doctor.phone
        div
          p(class="text-xs uppercase text-slate-500") Especialidad
          p(class="mt-1 font-semibold")= doctor.specialtyName
        div
          p(class="text-xs uppercase text-slate-500") Registro profesional
          p(class="mt-1 font-semibold")= doctor.professionalRegistration
        div
          p(class="text-xs uppercase text-slate-500") Estado de cuenta
          p(class="mt-1 font-semibold")= doctor.accountStatus
        div
          p(class="text-xs uppercase text-slate-500") Invitación
          p(class="mt-1 font-semibold")= doctor.invitation.label
          if doctor.invitation.expiresAt
            p(class="mt-1 text-xs text-slate-500") Vence: #{new Intl.DateTimeFormat("es-CO", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Bogota" }).format(new Date(doctor.invitation.expiresAt))}
        div
          p(class="text-xs uppercase text-slate-500") Correo verificado
          p(class="mt-1 font-semibold")= doctor.emailVerifiedAt ? "Sí" : "No"
        div
          p(class="text-xs uppercase text-slate-500") Contraseña configurada
          p(class="mt-1 font-semibold")= doctor.passwordConfiguredAt ? "Sí" : "No"
      a(class="mt-6 inline-flex rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/administrador/medicos/" + doctor.id + "/editar") Actualizar datos
