extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-10")
    section(class="w-full rounded-2xl bg-white p-8 shadow-lg ring-1 ring-slate-200 sm:p-10")
      p(class="text-center text-sm font-semibold uppercase tracking-widest text-medigo-blue") MediGo
      h1(class="mt-3 text-center text-2xl font-bold text-medigo-navy")= title
      p(class=deliveryFailed ? "mt-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900" : "mt-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-900", role=deliveryFailed ? "alert" : "status")= message
      a(class="mt-6 inline-flex rounded-lg bg-medigo-blue px-4 py-2 font-semibold text-white", href="/administrador/medicos/nuevo") Registrar otro médico
      a(class="ml-3 text-sm font-semibold text-medigo-blue underline", href="/administrador") Volver al panel
