extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-8 text-slate-800")
    section(class="mx-auto max-w-6xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador") ← Volver al panel
      header(class="mt-4")
        p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
        h1(class="mt-1 text-2xl font-bold text-medigo-navy") Configurar horarios médicos
        p(class="mt-1 text-sm text-slate-600") Define la disponibilidad semanal en hora local de Colombia. Los cambios conservan el historial.
      if message === "saved"
        p(class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900", role="status") Guardé el nuevo horario. Cancelé #{cancelled || 0} cita(s) confirmada(s) que quedaban fuera de la disponibilidad.
      if failedNotifications
        p(class="mt-3 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No se pudieron enviar #{failedNotifications} aviso(s) por correo. El cambio quedó guardado.
      if page.status === "error"
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No pudimos cargar los médicos y sus horarios.
      else if page.status === "unavailable"
        p(class="mt-4 rounded-xl bg-sky-50 p-4 text-sm text-sky-900", role="status") La configuración de horarios todavía no está disponible. Ejecuta las migraciones pendientes.
      form(class="mt-5 flex flex-wrap items-end gap-3 rounded-2xl border border-slate-200 bg-white p-4", action="/administrador/horarios", method="get")
        div(class="min-w-64 flex-1")
          label(class="mb-1 block text-sm font-semibold", for="doctorId") Médico
          select#doctorId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="doctorId", required)
            option(value="") Selecciona un médico
            each doctor in page.doctors
              option(value=doctor.id, selected=page.selectedDoctor && String(page.selectedDoctor.id) === String(doctor.id))= doctor.name + " · " + doctor.specialtyName + (doctor.accountStatus === "INACTIVE" ? " · cuenta inactiva" : "")
        button(class="rounded-lg border border-medigo-blue px-4 py-2 font-semibold text-medigo-blue", type="submit") Consultar
      if page.selectedDoctor
        section(class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7")
          h2(class="text-lg font-bold text-medigo-navy")= page.selectedDoctor.name
          p(class="mt-1 text-sm text-slate-600")= page.selectedDoctor.specialtyName
          if page.blocks.length
            h3(class="mt-5 font-semibold text-medigo-navy") Horario vigente
            ul(class="mt-2 grid gap-2 sm:grid-cols-2")
              each block in page.blocks
                li(class="rounded-lg bg-slate-50 px-4 py-3 text-sm")
                  span(class="font-semibold")= weekdayNames[block.weekday]
                  span(class="ml-2") #{block.startsAt} – #{block.endsAt}
          else
            p(class="mt-4 rounded-lg bg-sky-50 p-4 text-sm text-sky-900") Este médico todavía no tiene un horario semanal vigente.
          form(class="mt-6", action="/administrador/horarios/" + page.selectedDoctor.id + "/vista-previa", method="post")
            input(type="hidden", name="_csrf", value=csrfToken)
            h3(class="font-semibold text-medigo-navy") Nuevo horario semanal
            p(class="mt-1 text-sm text-slate-600") Agrega uno o más bloques. Cada bloque debe empezar y terminar en intervalos de 30 minutos y no puede cruzar medianoche.
            if errors && errors.blocks
              p(class="mt-3 rounded-lg bg-rose-50 p-3 text-sm text-rose-800", role="alert")= errors.blocks
            table(class="mt-4 w-full text-left text-sm")
              thead(class="text-xs uppercase text-slate-500")
                tr
                  th(class="pb-2") Día
                  th(class="pb-2") Inicio
                  th(class="pb-2") Fin
                  th(class="pb-2")
              tbody#schedule-blocks
                each block in values.blocks
                  tr(class="border-t border-slate-100")
                    td(class="py-2 pr-2")
                      select(class="w-full rounded-lg border border-slate-300 px-2 py-2", name="weekday", required)
                        option(value="") Selecciona
                        each label, index in weekdayNames
                          if index > 0
                            option(value=index, selected=String(block.weekday) === String(index))= label
                    td(class="py-2 pr-2")
                      input(class="w-full rounded-lg border border-slate-300 px-2 py-2", type="time", name="startsAt", value=block.startsAt || "", step="1800", required)
                    td(class="py-2 pr-2")
                      input(class="w-full rounded-lg border border-slate-300 px-2 py-2", type="time", name="endsAt", value=block.endsAt || "", step="1800", required)
                    td(class="py-2")
                      button(class="rounded px-2 py-1 text-rose-700 hover:bg-rose-50", type="button", data-remove-block, aria-label="Quitar bloque") Quitar
            template#schedule-block-template
              tr(class="border-t border-slate-100")
                td(class="py-2 pr-2")
                  select(class="w-full rounded-lg border border-slate-300 px-2 py-2", name="weekday", required)
                    option(value="") Selecciona
                    each label, index in weekdayNames
                      if index > 0
                        option(value=index)= label
                td(class="py-2 pr-2")
                  input(class="w-full rounded-lg border border-slate-300 px-2 py-2", type="time", name="startsAt", step="1800", required)
                td(class="py-2 pr-2")
                  input(class="w-full rounded-lg border border-slate-300 px-2 py-2", type="time", name="endsAt", step="1800", required)
                td(class="py-2")
                  button(class="rounded px-2 py-1 text-rose-700 hover:bg-rose-50", type="button", data-remove-block, aria-label="Quitar bloque") Quitar
            div(class="mt-4 flex flex-wrap gap-3")
              button#add-schedule-block(class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700", type="button") Agregar otro bloque
              button(class="rounded-lg bg-medigo-blue px-5 py-2 font-semibold text-white", type="submit") Revisar citas afectadas
        script.
          (() => {
            const rows = document.getElementById("schedule-blocks");
            const template = document.getElementById("schedule-block-template");
            document.getElementById("add-schedule-block")?.addEventListener("click", () => {
              rows.appendChild(document.importNode(template.content, true));
            });
            rows?.addEventListener("click", (event) => {
              if (event.target.matches("[data-remove-block]")) event.target.closest("tr").remove();
            });
          })();
