extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-10 sm:px-6")
    div(class="mx-auto max-w-2xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/mi-cuenta") ← Volver a Mi cuenta
      section(class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 sm:p-8")
        h1(class="text-2xl font-bold text-medigo-navy") Cambiar contraseña
        p(class="mt-2 text-sm text-slate-600") Confirma tu contraseña actual y elige una nueva para proteger tu cuenta.
        if message
          p(class="mt-5 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900", role="status")= message
        form(class="mt-6 space-y-5", action="/administrador/cambiar-contrasena", method="post")
          input(type="hidden", name="_csrf", value=csrfToken)
          div
            label(class="mb-1 block text-sm font-medium text-medigo-navy", for="currentPassword") Contraseña actual
            input(class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue/20", id="currentPassword", name="currentPassword", type="password", required, autocomplete="current-password")
            if errors.currentPassword
              p(class="mt-1 text-xs text-rose-700", role="alert")= errors.currentPassword
          div
            label(class="mb-1 block text-sm font-medium text-medigo-navy", for="newPassword") Nueva contraseña
            input(class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue/20", id="newPassword", name="newPassword", type="password", required, minlength="8", autocomplete="new-password")
            p(class="mt-1 text-xs text-slate-500") Usa al menos 8 caracteres.
            if errors.newPassword
              p(class="mt-1 text-xs text-rose-700", role="alert")= errors.newPassword
          div
            label(class="mb-1 block text-sm font-medium text-medigo-navy", for="passwordConfirmation") Confirma la nueva contraseña
            input(class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue/20", id="passwordConfirmation", name="passwordConfirmation", type="password", required, minlength="8", autocomplete="new-password")
            if errors.passwordConfirmation
              p(class="mt-1 text-xs text-rose-700", role="alert")= errors.passwordConfirmation
          button(class="w-full rounded-lg bg-medigo-blue px-4 py-3 text-sm font-semibold text-white hover:bg-medigo-navy focus:outline-none focus:ring-2 focus:ring-medigo-blue focus:ring-offset-2", type="submit") Actualizar contraseña
