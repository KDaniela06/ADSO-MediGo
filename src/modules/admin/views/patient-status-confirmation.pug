extends ../../../views/shared/layout.pug

block content
  .min-h-screen.bg-slate-100.px-4.py-8.text-slate-800
    main(class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/pacientes") ← Volver a pacientes
      h1(class="mt-4 text-2xl font-bold text-medigo-navy") Confirmar cambio de estado
      p(class="mt-3 text-sm text-slate-600") Vas a #{newStatus === "INACTIVE" ? "desactivar" : "activar"} la cuenta de #{patient.firstName} #{patient.lastName}.
      p(class="mt-2 text-sm text-slate-600") Este cambio quedará registrado con tu usuario administrador y la fecha.
      if message
        p(role="alert", class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900")= message
      form(class="mt-5 space-y-4", action="/administrador/pacientes/" + patient.id + "/estado", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        input(type="hidden", name="newStatus", value=newStatus)
        label(class="flex items-start gap-3 rounded-xl bg-slate-50 p-4 text-sm")
          input(type="checkbox", name="confirmed", value="YES", required)
          span Confirmo que quiero #{newStatus === "INACTIVE" ? "desactivar" : "activar"} esta cuenta.
        button(class="rounded-lg bg-medigo-blue px-5 py-3 font-semibold text-white", type="submit") Confirmar cambio
