extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto min-h-screen max-w-3xl bg-slate-100 px-4 py-8 text-slate-800")
    a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/medicos/" + doctor.id) ← Volver al detalle
    section(class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8")
      p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
      h1(class="mt-1 text-2xl font-bold text-medigo-navy") Actualizar datos del médico
      p(class="mt-2 text-sm text-slate-600") El correo se muestra en el detalle; para cambiarlo debe confirmarse desde el flujo de correo.
      if message
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert")= message
      form(class="mt-5 space-y-4", action="/administrador/medicos/" + doctor.id + "/editar", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        div(class="grid gap-4 sm:grid-cols-2")
          div
            label(class="mb-1 block text-sm font-semibold", for="firstName") Nombres
            input#firstName(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="firstName", value=values.firstName, maxlength="100", required)
            if errors.firstName
              p(class="mt-1 text-sm text-rose-700")= errors.firstName
          div
            label(class="mb-1 block text-sm font-semibold", for="lastName") Apellidos
            input#lastName(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="lastName", value=values.lastName, maxlength="100", required)
            if errors.lastName
              p(class="mt-1 text-sm text-rose-700")= errors.lastName
          div
            label(class="mb-1 block text-sm font-semibold", for="phone") Teléfono
            input#phone(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="phone", value=values.phone, type="tel", maxlength="30", required)
            if errors.phone
              p(class="mt-1 text-sm text-rose-700")= errors.phone
          div
            label(class="mb-1 block text-sm font-semibold", for="professionalRegistration") Registro profesional
            input#professionalRegistration(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="professionalRegistration", value=values.professionalRegistration, maxlength="80", required)
            if errors.professionalRegistration
              p(class="mt-1 text-sm text-rose-700")= errors.professionalRegistration
          div(class="sm:col-span-2")
            label(class="mb-1 block text-sm font-semibold", for="specialtyId") Especialidad
            select#specialtyId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="specialtyId", required)
              each specialty in specialties
                option(value=specialty.id, selected=String(values.specialtyId) === String(specialty.id))= specialty.name + (specialty.status === "ACTIVE" ? "" : " (inactiva)")
            if errors.specialtyId
              p(class="mt-1 text-sm text-rose-700")= errors.specialtyId
        p(class="rounded-xl bg-sky-50 p-4 text-sm text-sky-900") El correo, el documento y el estado de la cuenta no se cambian en este formulario. Cada actualización se guarda en la auditoría.
        button(class="rounded-lg bg-medigo-blue px-5 py-3 font-semibold text-white", type="submit") Guardar cambios
