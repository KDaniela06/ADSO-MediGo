extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-8 text-slate-800")
    section(class="mx-auto max-w-6xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador") ← Volver al panel
      header(class="mt-4 flex flex-wrap items-end justify-between gap-3")
        div
          p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
          h1(class="mt-1 text-2xl font-bold text-medigo-navy") Gestionar especialidades
          p(class="mt-1 text-sm text-slate-600") Mantén actualizado el catálogo que se ofrece para nuevas reservas.
        a(class="rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/administrador/especialidades/nueva") Agregar especialidad
      if message === "created"
        p(class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900", role="status") La especialidad se creó correctamente.
      else if message === "updated"
        p(class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900", role="status") Los datos de la especialidad se actualizaron.
      else if message === "status-updated"
        p(class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900", role="status") El estado de la especialidad se actualizó. Su historial y las citas existentes se conservaron.
      if result.status === "error"
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No pudimos cargar las especialidades. Inténtalo más tarde.
      else if result.status === "unavailable"
        p(class="mt-4 rounded-xl bg-sky-50 p-4 text-sm text-sky-900", role="status") El catálogo de especialidades no está disponible.
      form(class="mt-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_220px_auto]", action="/administrador/especialidades", method="get")
        div
          label(class="sr-only", for="q") Buscar por nombre o descripción
          input#q(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="q", placeholder="Nombre o descripción", value=result.search)
        div
          label(class="sr-only", for="estado") Estado
          select#estado(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="estado")
            option(value="") Todos los estados
            option(value="ACTIVE", selected=result.selectedStatus === "ACTIVE") Activa
            option(value="INACTIVE", selected=result.selectedStatus === "INACTIVE") Inactiva
        button(class="rounded-lg border border-medigo-blue px-4 py-2 text-sm font-semibold text-medigo-blue", type="submit") Aplicar filtros
      p(class="mt-4 text-sm text-slate-600")= result.total + " especialidades"
      if result.specialties.length
        .mt-3.overflow-x-auto.rounded-2xl.border.border-slate-200.bg-white
          table(class="w-full min-w-[680px] text-left text-sm")
            thead(class="bg-slate-50 text-xs uppercase text-slate-500")
              tr
                th(class="px-4 py-3") Nombre
                th(class="px-4 py-3") Descripción
                th(class="px-4 py-3") Estado
                th(class="px-4 py-3") Acciones
            tbody
              each specialty in result.specialties
                tr(class="border-t border-slate-100")
                  td(class="px-4 py-3 font-semibold text-medigo-navy")= specialty.name
                  td(class="px-4 py-3")= specialty.description || "Sin descripción"
                  td(class="px-4 py-3")
                    span(class=specialty.status === "ACTIVE" ? "rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800" : "rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700")= specialty.status === "ACTIVE" ? "Activa" : "Inactiva"
                  td(class="px-4 py-3")
                    a(class="font-semibold text-medigo-blue hover:underline", href="/administrador/especialidades/" + specialty.id + "/editar") Editar
                    form(class="ml-3 inline", action="/administrador/especialidades/" + specialty.id + "/estado", method="post")
                      input(type="hidden", name="_csrf", value=csrfToken)
                      if specialty.status === "ACTIVE"
                        input(type="hidden", name="status", value="INACTIVE")
                        button(class="font-semibold text-rose-700 hover:underline", type="submit") Desactivar
                      else
                        input(type="hidden", name="status", value="ACTIVE")
                        button(class="font-semibold text-emerald-700 hover:underline", type="submit") Activar
      else
        p(class="mt-3 rounded-xl bg-white p-5 text-sm text-slate-600") No encontramos especialidades con esos filtros.
      if result.page > 1 || result.page < result.pageCount
        nav(class="mt-5 flex items-center justify-between", aria-label="Paginación")
          if result.page > 1
            a(class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold", href="/administrador/especialidades?q=" + encodeURIComponent(result.search) + "&estado=" + encodeURIComponent(result.selectedStatus) + "&pagina=" + (result.page - 1)) Anterior
          else
            span
          p(class="text-sm text-slate-600") Página #{result.page} de #{result.pageCount}
          if result.page < result.pageCount
            a(class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold", href="/administrador/especialidades?q=" + encodeURIComponent(result.search) + "&estado=" + encodeURIComponent(result.selectedStatus) + "&pagina=" + (result.page + 1)) Siguiente
