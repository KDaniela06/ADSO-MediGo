extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 lg:flex")
    aside(class="bg-medigo-navy text-white lg:flex lg:w-64 lg:flex-col")
      a(class="flex items-center gap-3 px-6 py-5 text-2xl font-extrabold", href="/administrador/mi-cuenta", aria-label="MediGo, cuenta")
        span(class="flex h-11 w-11 items-center justify-center rounded-xl bg-medigo-cyan text-2xl", aria-hidden="true") ✚
        span Medi#[span(class="text-medigo-cyan") Go]
      nav(class="flex gap-1 overflow-x-auto px-3 pb-3 lg:block lg:flex-1 lg:space-y-1 lg:px-3 lg:py-5", aria-label="Navegación de administrador")
        a(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-sky-100 hover:bg-white/10", href="/administrador")
          span(class="w-5 text-center", aria-hidden="true") ⌂
          span Inicio
        button(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 opacity-70", type="button", disabled)
          span(class="w-5 text-center", aria-hidden="true") ♙
          span Pacientes
        button(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 opacity-70", type="button", disabled)
          span(class="w-5 text-center", aria-hidden="true") ⚕
          span Médicos
        button(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 opacity-70", type="button", disabled)
          span(class="w-5 text-center", aria-hidden="true") ▦
          span Especialidades
        button(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 opacity-70", type="button", disabled)
          span(class="w-5 text-center", aria-hidden="true") ▣
          span Citas
        button(class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 opacity-70", type="button", disabled)
          span(class="w-5 text-center", aria-hidden="true") ▤
          span Reportes
        a(class="flex shrink-0 items-center gap-3 rounded-xl bg-medigo-cyan px-4 py-3 text-sm font-semibold text-white", href="/administrador/mi-cuenta", aria-current="page")
          span(class="w-5 text-center", aria-hidden="true") ♙
          span Mi cuenta
      form(class="hidden border-t border-white/15 p-4 lg:block", action="/cerrar-sesion", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        button(class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-sky-100 hover:bg-white/10", type="submit")
          span(class="w-5 text-center", aria-hidden="true") ⇥
          span Cerrar sesión
    section(class="min-w-0 flex-1")
      header(class="flex h-16 items-center justify-end gap-4 border-b border-slate-200 bg-white px-5 sm:px-8")
        button(class="relative rounded-full p-2 text-slate-600", type="button", aria-label="Notificaciones")
          span(aria-hidden="true") ♧
        div(class="flex items-center gap-2")
          span(class="flex h-9 w-9 items-center justify-center rounded-full bg-medigo-blue text-sm font-semibold text-white") #{(account.firstName || "A")[0]}#{(account.lastName || "")[0] || ""}
          span(class="hidden text-sm font-medium text-medigo-navy sm:block") #{account.firstName || "Admin"} #{account.lastName || ""}
      div(class="mx-auto max-w-5xl px-4 py-8 sm:px-8")
        div(class="mb-6")
          h1(class="text-2xl font-bold text-medigo-navy") Mi cuenta
          p(class="mt-1 text-sm text-slate-600") Consulta y actualiza tus datos de administrador.
        section(class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-8")
          if message
            p(class="mb-5 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900", role="status")= message
          if account.pendingEmail
            p(class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900") Tienes pendiente confirmar #{account.pendingEmail}. Tu correo actual sigue activo hasta que confirmes el enlace.
          div(class="mb-7 flex items-center gap-5 border-b border-slate-100 pb-6")
            div(class="flex h-20 w-20 items-center justify-center rounded-full bg-sky-100 text-3xl font-semibold text-medigo-blue", aria-label="Foto de perfil")
              span(aria-hidden="true") #{(account.firstName || "A")[0]}#{(account.lastName || "")[0] || ""}
            div
              h2(class="text-xl font-bold text-medigo-navy") #{account.firstName || ""} #{account.lastName || ""}
              p(class="mt-1 text-sm text-slate-600") Administrador de MediGo
          form(action="/administrador/mi-cuenta", method="post")
            input(type="hidden", name="_csrf", value=csrfToken)
            div(class="grid gap-x-10 gap-y-6 md:grid-cols-2")
              fieldset
                legend(class="mb-3 text-base font-bold text-medigo-navy") Información personal
                div(class="space-y-4")
                  div
                    label(class="mb-1 block text-sm text-slate-700", for="firstName") Nombres
                    input(class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-medigo-navy focus:border-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue/20", id="firstName", name="firstName", value=values.firstName || "", required, maxlength="100", autocomplete="given-name")
                    if errors.firstName
                      p(class="mt-1 text-xs text-rose-700", role="alert")= errors.firstName
                  div
                    label(class="mb-1 block text-sm text-slate-700", for="lastName") Apellidos
                    input(class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-medigo-navy focus:border-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue/20", id="lastName", name="lastName", value=values.lastName || "", required, maxlength="100", autocomplete="family-name")
                    if errors.lastName
                      p(class="mt-1 text-xs text-rose-700", role="alert")= errors.lastName
                  div(class="rounded-lg bg-slate-50 px-3 py-2")
                    p(class="text-xs text-slate-500") Documento (solo lectura)
                    p(class="mt-1 text-sm font-medium text-medigo-navy") #{account.documentType || ""} · #{account.documentNumber || ""}
              fieldset
                legend(class="mb-3 text-base font-bold text-medigo-navy") Información de contacto
                div(class="space-y-4")
                  div
                    label(class="mb-1 block text-sm text-slate-700", for="email") Correo electrónico
                    input(class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-medigo-navy focus:border-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue/20", id="email", name="email", type="email", value=values.email || "", required, maxlength="254", autocomplete="email")
                    if errors.email
                      p(class="mt-1 text-xs text-rose-700", role="alert")= errors.email
                  div
                    label(class="mb-1 block text-sm text-slate-700", for="phone") Teléfono
                    input(class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-medigo-navy focus:border-medigo-blue focus:outline-none focus:ring-2 focus:ring-medigo-blue/20", id="phone", name="phone", type="tel", value=values.phone || "", required, maxlength="30", autocomplete="tel")
                    if errors.phone
                      p(class="mt-1 text-xs text-rose-700", role="alert")= errors.phone
            button(class="mt-7 w-full rounded-lg bg-medigo-blue px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-medigo-navy focus:outline-none focus:ring-2 focus:ring-medigo-blue focus:ring-offset-2", type="submit") Guardar cambios
          a(class="mt-4 flex items-center justify-between rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold text-medigo-navy hover:bg-slate-50", href="/administrador/cambiar-contrasena")
            span Cambiar contraseña
            span(class="text-lg text-slate-500", aria-hidden="true") ›
