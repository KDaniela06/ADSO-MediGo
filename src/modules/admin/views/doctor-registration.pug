extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto min-h-screen max-w-4xl bg-slate-100 px-4 py-8 text-slate-800")
    a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador") ← Volver al panel
    section(class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8")
      p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
      h1(class="mt-1 text-2xl font-bold text-medigo-navy") Registrar médico
      p(class="mt-2 text-sm text-slate-600") Completa los datos profesionales. Enviaremos una invitación para que el médico configure su cuenta.
      if message
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert")= message
      form(class="mt-6 space-y-5", action="/administrador/medicos/nuevo", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        fieldset
          legend(class="mb-3 text-base font-bold text-medigo-navy") Datos personales
          div(class="grid gap-4 sm:grid-cols-2")
            div
              label(class="mb-1 block text-sm font-semibold", for="firstName") Nombres
              input#firstName(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="firstName", value=values.firstName || "", maxlength="100", autocomplete="given-name", required)
              if errors.firstName
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.firstName
            div
              label(class="mb-1 block text-sm font-semibold", for="lastName") Apellidos
              input#lastName(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="lastName", value=values.lastName || "", maxlength="100", autocomplete="family-name", required)
              if errors.lastName
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.lastName
            div
              label(class="mb-1 block text-sm font-semibold", for="documentType") Tipo de documento
              select#documentType(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="documentType", required)
                option(value="") Selecciona una opción
                option(value="CC", selected=values.documentType === "CC") Cédula de ciudadanía
                option(value="CE", selected=values.documentType === "CE") Cédula de extranjería
                option(value="PASSPORT", selected=values.documentType === "PASSPORT") Pasaporte
              if errors.documentType
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.documentType
            div
              label(class="mb-1 block text-sm font-semibold", for="documentNumber") Número de documento
              input#documentNumber(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="documentNumber", value=values.documentNumber || "", maxlength="30", required)
              if errors.documentNumber
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.documentNumber
            div
              label(class="mb-1 block text-sm font-semibold", for="email") Correo electrónico
              input#email(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="email", type="email", value=values.email || "", maxlength="254", autocomplete="email", required)
              if errors.email
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.email
            div
              label(class="mb-1 block text-sm font-semibold", for="phone") Teléfono
              input#phone(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="phone", type="tel", value=values.phone || "", maxlength="30", autocomplete="tel", required)
              if errors.phone
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.phone
        fieldset
          legend(class="mb-3 text-base font-bold text-medigo-navy") Datos profesionales
          div(class="grid gap-4 sm:grid-cols-2")
            div
              label(class="mb-1 block text-sm font-semibold", for="specialtyId") Especialidad
              select#specialtyId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="specialtyId", required)
                option(value="") Selecciona una especialidad activa
                each specialty in specialties
                  option(value=specialty.id, selected=String(values.specialtyId || "") === String(specialty.id))= specialty.name
              if errors.specialtyId
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.specialtyId
            div
              label(class="mb-1 block text-sm font-semibold", for="professionalRegistration") Registro profesional
              input#professionalRegistration(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="professionalRegistration", value=values.professionalRegistration || "", maxlength="80", required)
              if errors.professionalRegistration
                p(class="mt-1 text-sm text-rose-700", role="alert")= errors.professionalRegistration
        p(class="rounded-xl bg-sky-50 p-4 text-sm text-sky-900") La contraseña no se define aquí. El médico recibirá un enlace de un solo uso, válido por 24 horas.
        button(class="rounded-lg bg-medigo-blue px-5 py-3 font-semibold text-white hover:bg-medigo-navy", type="submit") Crear cuenta y enviar invitación
