extends ../../../views/shared/layout.pug

block content
  main(class="mx-auto min-h-screen max-w-4xl bg-slate-100 px-4 py-8 text-slate-800")
    a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/horarios?doctorId=" + doctor.id) ← Volver al horario
    section(class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8")
      p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
      h1(class="mt-1 text-2xl font-bold text-medigo-navy") Confirmar cambio de horario
      p(class="mt-2 text-sm text-slate-600") El nuevo horario entrará en vigor hoy, en hora de Colombia. La versión anterior quedará guardada en el historial.
      if previewChanged
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") Las citas afectadas cambiaron desde la última revisión. Revisa esta lista antes de confirmar.
      h2(class="mt-6 font-bold text-medigo-navy") Bloques del nuevo horario
      ul(class="mt-2 grid gap-2 sm:grid-cols-2")
        each block in blocks
          li(class="rounded-lg bg-slate-50 px-4 py-3 text-sm")
            span(class="font-semibold")= weekdayNames[block.weekday]
            span(class="ml-2") #{block.startsAt} – #{block.endsAt}
      h2(class="mt-6 font-bold text-medigo-navy") Citas futuras que se cancelarían
      if appointments.length
        p(class="mt-1 text-sm text-slate-600") Si confirmas, cancelaré estas citas confirmadas y avisaré a cada paciente por correo.
        ul(class="mt-3 divide-y divide-slate-100 rounded-xl border border-slate-200")
          each appointment in appointments
            li(class="flex flex-wrap justify-between gap-2 px-4 py-3 text-sm")
              span(class="font-semibold text-medigo-navy")= appointment.patientName
              span(class="text-slate-600")= appointment.date + " · " + appointment.time
      else
        p(class="mt-2 rounded-lg bg-emerald-50 p-4 text-sm text-emerald-900") No hay citas futuras confirmadas que queden fuera del horario nuevo.
      form(class="mt-6 flex flex-wrap gap-3", action="/administrador/horarios/" + doctor.id + "/guardar", method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        input(type="hidden", name="confirmed", value="YES")
        each block in blocks
          input(type="hidden", name="weekday", value=block.weekday)
          input(type="hidden", name="startsAt", value=block.startsAt)
          input(type="hidden", name="endsAt", value=block.endsAt)
        each appointment in appointments
          input(type="hidden", name="confirmedAppointmentIds", value=appointment.id)
        button(class="rounded-lg bg-medigo-blue px-5 py-3 font-semibold text-white", type="submit") Confirmar y guardar horario
        a(class="rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-700", href="/administrador/horarios?doctorId=" + doctor.id) Cancelar
