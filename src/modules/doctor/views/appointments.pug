extends ../../../views/shared/layout.pug

block content
  .min-h-screen.bg-slate-50.text-slate-800(class="md:flex")
    aside(class="bg-medigo-navy text-white md:min-h-screen md:w-64 md:shrink-0")
      .flex.items-center.gap-3.px-5.py-4(class="md:flex-col md:items-start md:px-6 md:py-8")
        a(href="/medico", aria-label="MediGo, inicio", class="text-2xl font-extrabold tracking-tight") Medi#[span(class="text-medigo-cyan") Go]
        nav(aria-label="Navegación principal", class="ml-auto flex gap-2 overflow-x-auto text-sm md:ml-0 md:mt-10 md:w-full md:flex-col md:gap-1")
          a(href="/medico", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Inicio
          a(href="/medico/citas", aria-current="page", class="whitespace-nowrap rounded-lg bg-medigo-blue px-3 py-2 font-semibold") Mis citas
          a(href="/medico/pacientes", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mis pacientes
          a(href="/medico/agenda", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mi agenda
          a(href="/medico/perfil", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mi perfil
        form(action="/cerrar-sesion", method="post", class="hidden md:mt-auto md:block md:w-full")
          input(type="hidden", name="_csrf", value=csrfToken)
          button(type="submit", class="mt-8 w-full rounded-lg px-3 py-2 text-left text-sm text-sky-100 hover:bg-white/10") Cerrar sesión

    main(class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 md:py-10")
      header(class="mb-6")
        a(href="/medico", class="text-sm font-semibold text-medigo-blue hover:underline") ← Volver al panel
        h1(class="mt-2 text-2xl font-bold text-medigo-navy sm:text-3xl") Mis citas
        p(class="mt-1 text-sm text-slate-600") Consulta las citas asignadas a tu agenda.

      form(action="/medico/citas", method="get", class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-3 sm:items-end")
        label(class="block text-sm font-semibold text-slate-700")
          span(class="mb-1 block") Fecha
          input(type="date", name="date", value=filters.date, class="w-full rounded-lg border border-slate-300 px-3 py-2")
          if errors && errors.date
            span(class="mt-1 block text-xs text-rose-700") #{errors.date}
        label(class="block text-sm font-semibold text-slate-700")
          span(class="mb-1 block") Estado
          select(name="status", class="w-full rounded-lg border border-slate-300 px-3 py-2")
            option(value="") Todos los estados
            each appointmentStatus in appointmentStatuses
              option(value=appointmentStatus, selected=filters.status === appointmentStatus)
                if appointmentStatus === "CONFIRMED"
                  | Confirmada
                else if appointmentStatus === "IN_PROGRESS"
                  | En curso
                else if appointmentStatus === "ATTENDED"
                  | Atendida
                else if appointmentStatus === "CANCELLED"
                  | Cancelada
                else
                  | No asistió
          if errors && errors.status
            span(class="mt-1 block text-xs text-rose-700") #{errors.status}
        button(type="submit", class="rounded-lg bg-medigo-blue px-4 py-2.5 font-semibold text-white hover:bg-medigo-navy") Filtrar citas

      if status === "error"
        p(role="alert", class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900") No pudimos cargar tus citas. Inténtalo de nuevo más tarde.
      else if status === "invalid"
        p(role="alert", class="mt-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800") Revisa los filtros e inténtalo de nuevo.
      else if appointments && appointments.length
        section(aria-label="Citas asignadas", class="mt-5 space-y-3")
          each appointment in appointments
            article(class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5")
              .flex.flex-col.gap-4(class="sm:flex-row sm:items-start sm:justify-between")
                div
                  p(class="text-sm font-semibold text-medigo-blue") #{appointment.date} · #{appointment.time}
                  h2(class="mt-1 text-lg font-bold text-medigo-navy") #{appointment.patientName}
                  p(class="mt-1 text-sm text-slate-600") #{appointment.specialty}
                  if appointment.documentNumber
                    p(class="mt-1 text-xs text-slate-500") #{appointment.documentType} #{appointment.documentNumber}
                  if appointment.phone
                    p(class="mt-1 text-xs text-slate-500") Contacto: #{appointment.phone}
                div(class="flex flex-col items-start gap-3 sm:items-end")
                  if appointment.status === "IN_PROGRESS"
                    span(class="rounded-full bg-sky-100 px-3 py-1 text-xs font-bold text-sky-800") En curso
                  else if appointment.status === "ATTENDED"
                    span(class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700") Atendida
                  else if appointment.status === "CANCELLED"
                    span(class="rounded-full bg-rose-100 px-3 py-1 text-xs font-bold text-rose-800") Cancelada
                  else if appointment.status === "NO_SHOW"
                    span(class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800") No asistió
                  else
                    span(class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800") Confirmada
                  a(href="/medico/citas/#{appointment.id}", class="text-sm font-semibold text-medigo-blue hover:underline") Ver detalles
                  if appointment.canStart
                    a(href="/medico/consultas/iniciar/#{appointment.id}", class="rounded-lg bg-medigo-blue px-3 py-2 text-sm font-semibold text-white hover:bg-medigo-navy") Iniciar atención
      else
        section(class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm")
          span(aria-hidden="true", class="text-3xl") ▣
          h2(class="mt-2 text-lg font-bold text-medigo-navy") No hay citas para mostrar
          p(class="mt-1 text-sm text-slate-600") Prueba con otra fecha o estado.

      form(action="/cerrar-sesion", method="post", class="mt-6 md:hidden")
        input(type="hidden", name="_csrf", value=csrfToken)
        button(type="submit", class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700") Cerrar sesión
