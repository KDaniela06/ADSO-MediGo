extends ../../../views/shared/layout.pug

block content
  .min-h-screen.bg-slate-50.text-slate-800(class="md:flex")
    aside(class="bg-medigo-navy text-white md:min-h-screen md:w-64 md:shrink-0")
      .flex.items-center.gap-3.px-5.py-4(class="md:flex-col md:items-start md:px-6 md:py-8")
        a(href="/medico", aria-label="MediGo, inicio", class="text-2xl font-extrabold tracking-tight") Medi#[span(class="text-medigo-cyan") Go]
        nav(aria-label="Navegación principal", class="ml-auto flex gap-2 overflow-x-auto text-sm md:ml-0 md:mt-10 md:w-full md:flex-col md:gap-1")
          a(href="/medico", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Inicio
          a(href="/medico/citas", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mis citas
          a(href="/medico/pacientes", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mis pacientes
          a(href="/medico/agenda", aria-current="page", class="whitespace-nowrap rounded-lg bg-medigo-blue px-3 py-2 font-semibold") Mi agenda
          a(href="/medico/perfil", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mi perfil
        form(action="/cerrar-sesion", method="post", class="hidden md:mt-auto md:block md:w-full")
          input(type="hidden", name="_csrf", value=csrfToken)
          button(type="submit", class="mt-8 w-full rounded-lg px-3 py-2 text-left text-sm text-sky-100 hover:bg-white/10") Cerrar sesión

    main(class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 md:py-10")
      header(class="mb-6")
        a(href="/medico", class="text-sm font-semibold text-medigo-blue hover:underline") ← Volver al panel
        h1(class="mt-2 text-2xl font-bold text-medigo-navy sm:text-3xl") Mi agenda
        p(class="mt-1 text-sm text-slate-600") Consulta los días y horarios asignados. Esta agenda es de solo lectura.
      if schedule.status === "error"
        p(role="alert", class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900") No pudimos cargar tu agenda. Inténtalo de nuevo más tarde.
      else if schedule.status === "not_configured"
        section(class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm")
          h2(class="text-lg font-bold text-medigo-navy") Tu agenda todavía no está configurada
          p(class="mt-2 text-sm text-slate-600") Cuando se registren tus horarios, podrás consultarlos aquí. Esta vista no permite crear ni modificar horarios o excepciones.
      else if schedule.status === "empty"
        section(class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm")
          h2(class="text-lg font-bold text-medigo-navy") No tienes horarios vigentes
          p(class="mt-2 text-sm text-slate-600") No hay bloques de disponibilidad asignados para hoy. La consulta es de solo lectura.
      else if schedule.status === "ready"
        section(class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm")
          h2(class="border-b border-slate-100 px-5 py-4 text-lg font-bold text-medigo-navy") Horarios semanales
          ul(class="divide-y divide-slate-100")
            each block in schedule.blocks
              li(class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-center sm:justify-between")
                span(class="font-semibold text-medigo-navy")= block.weekdayLabel
                span(class="text-sm text-slate-700") #{block.startsAt} – #{block.endsAt}
          p(class="border-t border-slate-100 bg-slate-50 px-5 py-3 text-xs text-slate-500") Los horarios se muestran en hora local de Colombia. No puedes modificarlos desde esta pantalla.
      form(action="/cerrar-sesion", method="post", class="mt-6 md:hidden")
        input(type="hidden", name="_csrf", value=csrfToken)
        button(type="submit", class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700") Cerrar sesión
