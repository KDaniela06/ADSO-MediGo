extends ../../../views/shared/layout.pug

block content
  .min-h-screen.bg-slate-50.text-slate-800(class="md:flex")
    aside(class="bg-medigo-navy text-white md:min-h-screen md:w-64 md:shrink-0")
      .flex.items-center.gap-3.px-5.py-4(class="md:flex-col md:items-start md:px-6 md:py-8")
        a(href="/medico", aria-label="MediGo, inicio", class="text-2xl font-extrabold tracking-tight") Medi#[span(class="text-medigo-cyan") Go]
        nav(aria-label="Navegación principal", class="ml-auto flex gap-2 overflow-x-auto text-sm md:ml-0 md:mt-10 md:w-full md:flex-col md:gap-1")
          a(href="/medico", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Inicio
          a(href="/medico/citas", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mis citas
          a(href="/medico/pacientes", aria-current="page", class="whitespace-nowrap rounded-lg bg-medigo-blue px-3 py-2 font-semibold") Mis pacientes
          a(href="/medico/agenda", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mi agenda
          a(href="/medico/perfil", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mi perfil
        form(action="/cerrar-sesion", method="post", class="hidden md:mt-auto md:block md:w-full")
          input(type="hidden", name="_csrf", value=csrfToken)
          button(type="submit", class="mt-8 w-full rounded-lg px-3 py-2 text-left text-sm text-sky-100 hover:bg-white/10") Cerrar sesión

    main(class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 md:py-10")
      header(class="mb-6")
        a(href="/medico", class="text-sm font-semibold text-medigo-blue hover:underline") ← Volver al panel
        h1(class="mt-2 text-2xl font-bold text-medigo-navy sm:text-3xl") Mis pacientes
        p(class="mt-1 text-sm text-slate-600") Aquí aparecen las personas que tienen citas asociadas a tu agenda.

      form(action="/medico/pacientes", method="get", role="search", class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row")
        label(for="patient-search", class="sr-only") Buscar paciente por nombre, identificación, teléfono o ciudad
        input#patient-search(type="search", name="q", value=search, maxlength="80", placeholder="Nombre, identificación, teléfono o ciudad", class="min-w-0 flex-1 rounded-lg border border-slate-300 px-4 py-2.5")
        button(type="submit", class="rounded-lg bg-medigo-blue px-5 py-2.5 font-semibold text-white hover:bg-medigo-navy") Buscar
        if search
          a(href="/medico/pacientes", class="rounded-lg border border-slate-300 px-4 py-2.5 text-center text-sm font-semibold text-slate-700 hover:bg-slate-50") Limpiar

      if status === "error"
        p(role="alert", class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900") No pudimos cargar tus pacientes. Inténtalo de nuevo más tarde.
      else if patients && patients.length
        section(aria-label="Pacientes asociados a tus citas", class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3")
          each patient in patients
            article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
              .flex.items-start.gap-3
                span(aria-hidden="true", class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky-100 font-bold text-medigo-blue") #{patient.name.slice(0, 1).toUpperCase()}
                div(class="min-w-0 flex-1")
                  h2(class="truncate font-bold text-medigo-navy") #{patient.name}
                  if patient.documentNumber
                    p(class="mt-1 text-sm text-slate-600") #{patient.documentType} #{patient.documentNumber}
              if patient.phone
                p(class="mt-3 text-sm text-slate-600") Teléfono: #{patient.phone}
              if patient.city
                p(class="mt-1 text-sm text-slate-600") #{patient.city}
              p(class="mt-3 text-xs text-slate-500") #{patient.appointmentCount} cita(s) asociada(s)
              a(href="/medico/pacientes/#{patient.id}", class="mt-4 inline-flex text-sm font-semibold text-medigo-blue hover:underline") Ver información básica →
      else
        section(class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm")
          span(aria-hidden="true", class="text-3xl") ◉
          h2(class="mt-2 text-lg font-bold text-medigo-navy") #{search ? "No encontramos coincidencias" : "Aún no tienes pacientes asociados"}
          p(class="mt-1 text-sm text-slate-600") #{search ? "Prueba con otro nombre o dato de contacto." : "Los pacientes con citas en tu agenda aparecerán aquí."}

      form(action="/cerrar-sesion", method="post", class="mt-6 md:hidden")
        input(type="hidden", name="_csrf", value=csrfToken)
        button(type="submit", class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700") Cerrar sesión
