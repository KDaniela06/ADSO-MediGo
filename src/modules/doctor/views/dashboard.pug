extends ../../../views/shared/layout.pug

block content
  .min-h-screen.bg-slate-50.text-slate-800(class="md:flex")
    aside(class="bg-medigo-navy text-white md:min-h-screen md:w-64 md:shrink-0")
      .flex.items-center.gap-3.px-5.py-4(class="md:flex-col md:items-start md:px-6 md:py-8")
        a(href="/medico", aria-label="MediGo, inicio", class="text-2xl font-extrabold tracking-tight") Medi#[span(class="text-medigo-cyan") Go]
        nav(aria-label="Navegación principal", class="ml-auto flex gap-2 overflow-x-auto text-sm md:ml-0 md:mt-10 md:w-full md:flex-col md:gap-1")
          a(href="/medico", aria-current="page", class="whitespace-nowrap rounded-lg bg-medigo-blue px-3 py-2 font-semibold") Inicio
          a(href="/medico/citas", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mis citas
          a(href="/medico/pacientes", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mis pacientes
          a(href="/medico/agenda", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mi agenda
          a(href="/medico/perfil", class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-white/10") Mi perfil
        form(action="/cerrar-sesion", method="post", class="hidden md:mt-auto md:block md:w-full")
          input(type="hidden", name="_csrf", value=csrfToken)
          button(type="submit", class="mt-8 w-full rounded-lg px-3 py-2 text-left text-sm text-sky-100 hover:bg-white/10") Cerrar sesión

    main(class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 md:py-10")
      header(class="mb-6 flex items-center justify-between")
        div
          p(class="text-sm font-semibold uppercase tracking-wider text-medigo-blue") Área médica
          h1(class="mt-1 text-2xl font-bold text-medigo-navy sm:text-3xl") Bienvenido, Dr. #{currentUser.firstName}
          p(class="mt-1 text-sm text-slate-600") Gestiona tus citas y pacientes
        span(class="hidden h-11 w-11 items-center justify-center rounded-full bg-sky-100 font-bold text-medigo-blue sm:flex") #{(currentUser.firstName || "M").slice(0, 1).toUpperCase()}

      if dashboard && dashboard.status === "error"
        p(role="alert", class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900") No pudimos cargar el resumen de tu jornada. Inténtalo de nuevo más tarde.

      - const counts = dashboard && dashboard.counts ? dashboard.counts : { today: 0, inProgress: 0, attended: 0 }
      section(aria-label="Resumen de la jornada", class="grid gap-3 sm:grid-cols-3")
        article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
          p(class="text-sm text-slate-600") Citas de hoy
          p(class="mt-1 text-3xl font-bold text-medigo-navy") #{counts.today}
        article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
          p(class="text-sm text-slate-600") En curso
          p(class="mt-1 text-3xl font-bold text-medigo-blue") #{counts.inProgress}
        article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
          p(class="text-sm text-slate-600") Atendidas
          p(class="mt-1 text-3xl font-bold text-emerald-700") #{counts.attended}

      .mt-6.grid.gap-5(class="lg:grid-cols-3")
        section(aria-labelledby="appointments-title", class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2 sm:p-6")
          .flex.items-center.justify-between
            h2#appointments-title(class="text-xl font-bold text-medigo-navy") Mis citas de hoy
            a(href="/medico/citas", class="text-sm font-semibold text-medigo-blue hover:underline") Ver todas →
          if dashboard && dashboard.status === "ready" && dashboard.appointments.length
            .mt-4.divide-y.divide-slate-100
              each appointment in dashboard.appointments
                article(class="flex flex-col gap-2 py-4 sm:flex-row sm:items-center sm:justify-between")
                  .flex.items-center.gap-4
                    span(class="min-w-20 rounded-lg bg-sky-50 px-3 py-2 text-center text-sm font-semibold text-medigo-blue") #{appointment.time}
                    h3(class="font-semibold text-medigo-navy") #{appointment.patientName}
                  if appointment.status === "IN_PROGRESS"
                    span(class="w-fit rounded-full bg-sky-100 px-3 py-1 text-xs font-bold text-sky-800") En curso
                  else if appointment.status === "ATTENDED"
                    span(class="w-fit rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700") Atendida
                  else if appointment.status === "CANCELLED"
                    span(class="w-fit rounded-full bg-rose-100 px-3 py-1 text-xs font-bold text-rose-800") Cancelada
                  else
                    span(class="w-fit rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800") Confirmada
          else if dashboard && dashboard.status === "error"
            p(class="mt-4 text-sm text-slate-600") Las citas aparecerán aquí cuando podamos consultar la agenda.
          else
            p(class="mt-4 rounded-xl bg-sky-50 p-4 text-sm text-slate-700") No tienes citas programadas para hoy.

        section(aria-labelledby="next-appointment-title", class="rounded-2xl bg-cyan-50 p-5 sm:p-6")
          span(aria-hidden="true", class="text-3xl") ♡
          h2#next-appointment-title(class="mt-3 text-xl font-bold text-medigo-navy") Próxima cita
          if dashboard && dashboard.nextAppointment
            p(class="mt-3 font-semibold text-slate-800") #{dashboard.nextAppointment.time} · #{dashboard.nextAppointment.patientName}
            p(class="mt-1 text-sm text-slate-600") #{dashboard.nextAppointment.status === "IN_PROGRESS" ? "En curso" : "Confirmada"}
          else
            p(class="mt-2 text-sm text-slate-700") No tienes próximas citas pendientes.
          a(href="/medico/agenda", class="mt-5 inline-flex rounded-lg bg-medigo-blue px-4 py-2.5 text-sm font-semibold text-white hover:bg-medigo-navy") Revisar mi agenda

      form(action="/cerrar-sesion", method="post", class="mt-6 md:hidden")
        input(type="hidden", name="_csrf", value=csrfToken)
        button(type="submit", class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700") Cerrar sesión
