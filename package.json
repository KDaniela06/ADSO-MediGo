{
  "name": "medigo",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma web para la gestión de citas médicas MediGo.",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run build:css && node src/server.js",
    "dev": "concurrently \"nodemon --watch src src/server.js\" \"npm run watch:css\"",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --minify",
    "db:migrate": "node scripts/migrate.js",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --watch",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mysql2": "^3.14.1",
    "nodemailer": "^10.4.0",
    "pug": "^3.0.3",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "jest": "^30.0.3",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}

